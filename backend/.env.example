PORT=5000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/scion
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
ROOT_NAME=
ROOT_EMAIL=
ROOT_PASSWORD=
# Set to this exact value only for deliberate one-time `npm run create-root`.
ROOT_BOOTSTRAP_CONFIRM=

# Transactional email provider: resend (recommended) or smtp.
# Email is mocked only when NODE_ENV=test.
EMAIL_PROVIDER=resend
EMAIL_FROM=Scion <no-reply@example.com>
# Required when EMAIL_PROVIDER=resend. Keep this backend-only; never use a VITE_ variable.
RESEND_API_KEY=re_replace-with-a-server-side-resend-api-key
# Required only when EMAIL_PROVIDER=smtp.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Optional SMTP auth; if used, set both values in the backend secret store.
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_SECURE=false
# Applies to both providers. Valid range: 1000-60000 milliseconds.
EMAIL_TIMEOUT_MS=20000
